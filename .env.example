# A análise de oratória roda inteiramente local (sem API de IA externa).
# Configure esta URL para habilitar o Vocal Coach com IA.
VITE_N8N_API_URL=https://n8n.seu-dominio.com/webhook/speek-it-api

# Backend e autenticação
JWT_SECRET=gere-um-segredo-longo-e-aleatorio
ADMIN_EMAIL=admin@seu-dominio.com
ADMIN_PASSWORD=use-uma-senha-forte

# Redis persistente (Vercel Marketplace / Upstash)
UPSTASH_REDIS_REST_URL=https://seu-banco.upstash.io
UPSTASH_REDIS_REST_TOKEN=seu-token
# A integração Vercel também pode criar UPSTASH_KV_REST_API_URL e
# UPSTASH_KV_REST_API_TOKEN; ambos os formatos são aceitos.
